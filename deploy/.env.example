# Copy to .env next to docker-compose.yml. Every value is read by the container at start.

# Login for the screening pages (HTTP Basic). Change both.
UI_USERNAME=compliance
UI_PASSWORD=change-me

# API key for the JSON API (tenant:key). The UI does not need it; scripts do.
API_KEYS=default:change-me-too

# Name shown on the printable summary ("Prepared for ...") can be set later with
# PUT /api/v1/tenant; the tenant slug is fixed here.
UI_TENANT=default

# Lists: the image carries the lists current at build time. To refresh from inside the container:
#   docker compose exec corridorcomply python scripts/update_sanctions.py
# then re-screen the customers on file:
#   docker compose exec corridorcomply python -m app.monitoring rescreen
